{
    "$schema": "https://json.schemastore.org/nest-cli",
    "collection": "@nestjs/schematics",
    "sourceRoot": "src",
    "compilerOptions": {
        "builder": "swc",
        "deleteOutDir": true,
        "assets": [
            { "include": "document/templates/**/*", "watchAssets": true },
            { "include": "i18n/**/*", "watchAssets": true }
        ]
    }
}
