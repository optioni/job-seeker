{
    "name": "job-seeker",
    "packageManager": "yarn@4.17.1",
    "private": true,
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev": "yarn workspaces foreach --all -pi run dev",
        "dev:api": "yarn workspace @job-seeker/api run start:dev",
        "dev:web": "yarn workspace @job-seeker/web run dev",
        "lint": "yarn workspaces foreach --all run lint",
        "lint:fix": "yarn workspaces foreach --all run lint:fix",
        "typecheck": "yarn workspaces foreach --all run typecheck",
        "test": "yarn workspaces foreach --all run test",
        "test:coverage": "yarn workspaces foreach --all run test:coverage"
    }
}
